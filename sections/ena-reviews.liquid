{%- comment -%}
  Reseñas de clientes — placeholder layout matching the review-app design
  (Judge.me/Loox/Okendo). Swap for the app's section/block once installed;
  all content here is static settings until then.
{%- endcomment -%}

<div class="section-background" style="background: #ffffff"></div>
<div
  class="section ena-rev spacing-style{% unless section.settings.animate %} reveal-off{% endunless %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="ena-rev__inner">
    <h2 class="ena-rev__title" data-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">{{ section.settings.heading }}</h2>

    <div class="ena-rev__summary" data-reveal="fade-up">
      <div class="ena-rev__avg">
        <span class="ena-rev__avg-number">{{ section.settings.average }}</span>
        <span class="ena-stars ena-stars--lg">
          {%- for i in (1..5) -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9L12 2.6z" stroke-linejoin="round"/></svg>
          {%- endfor -%}
        </span>
        <span class="ena-rev__total">{{ section.settings.total_text }}</span>
      </div>
      <div class="ena-rev__bars">
        {%- assign dist = '5,4,3,2,1' | split: ',' -%}
        {%- for star in dist -%}
          {%- liquid
            assign bar_key = 'bar_' | append: star
            assign pct = section.settings[bar_key]
          -%}
          <div class="ena-rev__bar-row">
            <span class="ena-rev__bar-star">{{ star }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="13" height="13"><path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9L12 2.6z" stroke-linejoin="round"/></svg>
            </span>
            <span class="ena-rev__bar-track"><span class="ena-rev__bar-fill" style="width: {{ pct }}%"></span></span>
          </div>
        {%- endfor -%}
      </div>
      <div class="ena-rev__cta">
        <button type="button" class="ena-rev__button">{{ section.settings.button_label }}</button>
      </div>
    </div>

    <div class="ena-rev__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ena-rev__inner {
    padding-block: 72px;
  }
  .ena-rev__title {
    font-size: 40px;
    margin: 0 0 34px;
  }
  .ena-rev__summary {
    display: flex;
    align-items: center;
    gap: 56px;
    border: 1px solid var(--ena-border);
    border-radius: 16px;
    padding: 36px 44px;
    margin-bottom: 32px;
  }
  .ena-rev__avg {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ena-rev__avg-number {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    color: var(--ena-ink);
  }
  .ena-rev__total {
    font-size: 13.5px;
    color: var(--ena-muted);
  }
  .ena-rev__bars {
    flex: 1;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ena-rev__bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ena-rev__bar-star {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--ena-muted);
    width: 34px;
  }
  .ena-rev__bar-star svg {
    color: var(--ena-gold);
  }
  .ena-rev__bar-track {
    flex: 1;
    height: 7px;
    border-radius: 999px;
    background: var(--ena-surface);
    overflow: hidden;
  }
  .ena-rev__bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--ena-ink);
  }
  .ena-rev__cta {
    margin-left: auto;
  }
  .ena-rev__button {
    background: #fff;
    border: 1.5px solid var(--ena-ink);
    border-radius: 6px;
    padding: 14px 26px;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ena-ink);
    cursor: pointer;
  }
  .ena-rev__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .ena-rev__card {
    border: 1px solid var(--ena-border);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ena-rev__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ena-rev__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ena-ink);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 15px;
  }
  .ena-rev__who {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .ena-rev__who strong {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--ena-ink);
  }
  .ena-rev__who small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #2e7d32;
  }
  .ena-rev__date {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--ena-muted);
  }
  .ena-rev__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ena-text-secondary);
    margin: 0;
  }
  @media screen and (max-width: 989px) {
    .ena-rev__summary {
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 28px 22px;
    }
    .ena-rev__bars {
      width: 100%;
      max-width: none;
    }
    .ena-rev__cta {
      margin-left: 0;
    }
    .ena-rev__button {
      width: 100%;
    }
    .ena-rev__grid {
      grid-template-columns: 1fr;
    }
    .ena-rev__title {
      font-size: 28px;
    }
    .ena-rev__inner {
      padding-block: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Reseñas",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_ena-review"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Placeholder — reemplazar por la sección de la app de reseñas con data real."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Reseñas de clientes"
    },
    {
      "type": "text",
      "id": "average",
      "label": "Promedio",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "total_text",
      "label": "Total",
      "default": "138 reseñas · 94% positivas"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Escribir reseña"
    },
    { "type": "range", "id": "bar_5", "label": "5★ %", "min": 0, "max": 100, "step": 1, "default": 82 },
    { "type": "range", "id": "bar_4", "label": "4★ %", "min": 0, "max": 100, "step": 1, "default": 12 },
    { "type": "range", "id": "bar_3", "label": "3★ %", "min": 0, "max": 100, "step": 1, "default": 3 },
    { "type": "range", "id": "bar_2", "label": "2★ %", "min": 0, "max": 100, "step": 1, "default": 2 },
    { "type": "range", "id": "bar_1", "label": "1★ %", "min": 0, "max": 100, "step": 1, "default": 1 },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable scroll animation",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation style",
      "default": "fade-up",
      "visible_if": "{{ section.settings.animate }}",
      "options": [
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "fade-left", "label": "Fade from right" },
        { "value": "fade-right", "label": "Fade from left" },
        { "value": "zoom", "label": "Zoom in" }
      ]
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Reseñas",
      "blocks": [
        { "type": "_ena-review", "settings": { "name": "Martín G.", "date": "hace 3 días", "stars": 5, "text": "Excelente creatina, se disuelve perfecto y en dos semanas noté más fuerza. La vuelvo a comprar seguro." } },
        { "type": "_ena-review", "settings": { "name": "Lucía R.", "date": "hace 1 semana", "stars": 5, "text": "Sin sabor va justo con el jugo. La tomo todos los días y la recuperación se nota un montón." } },
        { "type": "_ena-review", "settings": { "name": "Diego P.", "date": "hace 2 semanas", "stars": 4, "text": "Muy buena relación precio-calidad. El formato de 1 kg rinde muchísimo y la calidad es top." } }
      ]
    }
  ]
}
{% endschema %}
