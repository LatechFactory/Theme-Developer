{%- comment -%}
  "Respaldado por los mejores" — black social-proof band under the PDP details.
  Names are PLACEHOLDER (replace with real athletes/partners; UAR/Los Pumas is real).
{%- endcomment -%}

<div class="section-background" style="background: {{ section.settings.background }}"></div>
<div
  class="section ena-amb ena-carbon spacing-style{% unless section.settings.animate %} reveal-off{% endunless %}"
  style="{% render 'spacing-style', settings: section.settings %}; --ena-amb-bg: {{ section.settings.background }}"
  {{ section.shopify_attributes }}
>
  <div class="ena-amb__inner">
    <div class="ena-amb__head" data-reveal="{{ section.settings.animation_style | default: 'fade-up' }}">
      <span class="ena-amb__kicker">{{ section.settings.kicker }}</span>
      <h2 class="ena-amb__title">{{ section.settings.heading }}</h2>
      <p class="ena-amb__subtitle">{{ section.settings.subheading }}</p>
    </div>
    <div class="ena-amb__row">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .ena-amb {
    color: #fff;
  }
  .ena-amb__inner {
    padding-block: 88px;
  }
  .ena-amb__head {
    text-align: center;
    margin-bottom: 48px;
  }
  .ena-amb__kicker {
    display: inline-block;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    padding: 8px 18px;
    font-family: var(--font-body--family);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 22px;
  }
  .ena-amb__title {
    color: #fff;
    font-size: 44px;
    margin: 0 0 14px;
  }
  .ena-amb__subtitle {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ena-gold);
    margin: 0;
  }
  .ena-amb__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .ena-amb__card {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    background: #161616;
  }
  .ena-amb__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(35%);
  }
  .ena-amb__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 45%);
  }
  .ena-amb__label {
    position: absolute;
    left: 20px;
    right: 16px;
    bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ena-amb__label strong {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #fff;
  }
  .ena-amb__label small {
    font-family: var(--font-body--family);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
  }
  @media screen and (max-width: 989px) {
    .ena-amb__row {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .ena-amb__title {
      font-size: 30px;
    }
    .ena-amb__inner {
      padding-block: 56px;
    }
    .ena-amb__label {
      left: 14px;
      right: 12px;
      bottom: 12px;
      gap: 2px;
    }
    .ena-amb__label strong {
      font-size: 15px;
    }
    .ena-amb__label small {
      font-size: 11px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Ambassadors",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_ena-ambassador"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Respaldado por los mejores"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Atletas. Clubes. Resultados."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "TODOS ENTRENAN CON ENA."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fondo",
      "default": "#0A0A0A"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable scroll animation",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation style",
      "default": "fade-up",
      "visible_if": "{{ section.settings.animate }}",
      "options": [
        { "value": "fade-up", "label": "Fade up" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-down", "label": "Fade down" },
        { "value": "fade-left", "label": "Fade from right" },
        { "value": "fade-right", "label": "Fade from left" },
        { "value": "zoom", "label": "Zoom in" }
      ]
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Ambassadors",
      "blocks": [
        { "type": "_ena-ambassador", "settings": { "name": "Los Pumas", "role": "Proveedor oficial · UAR", "asset": "ena-amb-pumas.png" } },
        { "type": "_ena-ambassador", "settings": { "name": "Martín Salinas", "role": "Jugador profesional de rugby", "asset": "ena-amb-martin.png" } },
        { "type": "_ena-ambassador", "settings": { "name": "Julieta Ferro", "role": "Atleta de alto rendimiento", "asset": "ena-amb-julieta.png" } },
        { "type": "_ena-ambassador", "settings": { "name": "Andrés Molina", "role": "Médico deportólogo", "asset": "ena-amb-andres.png" } }
      ]
    }
  ]
}
{% endschema %}
