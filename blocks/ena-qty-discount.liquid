{%- comment -%}
  Descuento por cantidad (pack builder) — 3 packs en fila dentro del buy box.
  - UI only: el descuento REAL se aplica con un Automatic Discount de Shopify
    (por cantidad) o una app de quantity breaks. Acá NO se cobra el descuento;
    se muestra el total con descuento y se setea la cantidad en el stepper.
  - Precios y fotos se recalculan por variante (sabor + tamaño) en ena-pdp.js.
  - Compra única: es excluyente con Suscripción (elegir un pack fuerza onetime).
{%- endcomment -%}

{%- liquid
  assign v = closest.product.selected_or_first_available_variant
  assign base = v.price
  assign pct2 = block.settings.pack2_discount
  assign pct3 = block.settings.pack3_discount
  assign keep2 = 100 | minus: pct2
  assign keep3 = 100 | minus: pct3
  assign was2 = base | times: 2
  assign was3 = base | times: 3
  assign now2 = was2 | times: keep2 | divided_by: 100
  assign now3 = was3 | times: keep3 | divided_by: 100

  # Per-pack image: merchant can pin an explicit image for each pack in the
  # theme editor. If left empty, the pack falls back to the current variant
  # image (mirrored per flavor/size by ena-pdp.js). Fixed images are marked so
  # the JS never overwrites them on variant change.
  assign fallback_img = v.featured_image | default: closest.product.featured_image
  assign img1 = block.settings.image_x1 | default: fallback_img
  assign img2 = block.settings.image_x2 | default: fallback_img
  assign img3 = block.settings.image_x3 | default: fallback_img
-%}

<div
  class="ena-qd spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  data-ena-qd
  data-pct2="{{ pct2 }}"
  data-pct3="{{ pct3 }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="ena-caption ena-qd__heading">{{ block.settings.heading }}</p>
  {%- endif -%}

  <div class="ena-qd__grid">
    {%- comment -%} Pack x1 — default (sin descuento) {%- endcomment -%}
    <button type="button" class="ena-qd__pack is-selected" data-ena-qd-pack data-qty="1" data-pct="0">
      <span class="ena-qd__figure">
        <img class="ena-qd__img" data-ena-qd-img{% if block.settings.image_x1 != blank %} data-ena-qd-fixed="true"{% endif %} src="{{ img1 | image_url: width: 256 }}" alt="" width="128" height="110" loading="lazy">
      </span>
      <span class="ena-qd__qty">1 unidad</span>
      <span class="ena-qd__prices">
        <strong class="ena-qd__now" data-ena-qd-now>{{ base | money | split: ',' | first }}</strong>
      </span>
    </button>

    {%- comment -%} Pack x2 {%- endcomment -%}
    <button type="button" class="ena-qd__pack" data-ena-qd-pack data-qty="2" data-pct="{{ pct2 }}">
      <span class="ena-qd__tag">{{ block.settings.tag_prefix }} {{ pct2 }}%</span>
      <span class="ena-qd__figure">
        <img class="ena-qd__img" data-ena-qd-img{% if block.settings.image_x2 != blank %} data-ena-qd-fixed="true"{% endif %} src="{{ img2 | image_url: width: 256 }}" alt="" width="128" height="110" loading="lazy">
      </span>
      <span class="ena-qd__qty">2 unidades</span>
      <span class="ena-qd__prices">
        <s class="ena-qd__was" data-ena-qd-was>{{ was2 | money | split: ',' | first }}</s>
        <strong class="ena-qd__now" data-ena-qd-now>{{ now2 | money | split: ',' | first }}</strong>
      </span>
    </button>

    {%- comment -%} Pack x3 {%- endcomment -%}
    <button type="button" class="ena-qd__pack" data-ena-qd-pack data-qty="3" data-pct="{{ pct3 }}">
      <span class="ena-qd__tag">{{ block.settings.tag_prefix }} {{ pct3 }}%</span>
      <span class="ena-qd__figure">
        <img class="ena-qd__img" data-ena-qd-img{% if block.settings.image_x3 != blank %} data-ena-qd-fixed="true"{% endif %} src="{{ img3 | image_url: width: 256 }}" alt="" width="128" height="110" loading="lazy">
      </span>
      <span class="ena-qd__qty">3 unidades</span>
      <span class="ena-qd__prices">
        <s class="ena-qd__was" data-ena-qd-was>{{ was3 | money | split: ',' | first }}</s>
        <strong class="ena-qd__now" data-ena-qd-now>{{ now3 | money | split: ',' | first }}</strong>
      </span>
    </button>
  </div>
</div>

{% stylesheet %}
  .ena-qd__heading {
    margin: 0 0 12px;
  }
  .ena-qd__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .ena-qd__pack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 8px 12px;
    background: #fafafa;
    border: 1px solid var(--ena-border);
    border-radius: 12px;
    cursor: pointer;
    text-align: center;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .ena-qd__pack.is-selected {
    background: #fff;
    border: 1.5px solid var(--ena-ink);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 13.5px 7.5px 11.5px;
  }
  /* Savings tag — black for consistency with the .ena-badge / sale price (QA
     tickets 1 & 2). Handoff mock showed red; switch to var(--ena-sale) here to
     revert. */
  .ena-qd__tag {
    position: absolute;
    top: -9px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--ena-ink);
    color: #fff;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    line-height: 1.2;
  }
  .ena-qd__figure {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 88px;
  }
  .ena-qd__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .ena-qd__qty {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 13px;
    color: var(--ena-ink);
  }
  .ena-qd__prices {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    min-height: 34px;
    justify-content: flex-end;
  }
  .ena-qd__was {
    font-size: 12px;
    color: var(--ena-muted);
    text-decoration: line-through;
  }
  .ena-qd__now {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 16px;
    color: var(--ena-ink);
  }
  @media screen and (max-width: 749px) {
    .ena-qd__grid {
      gap: 8px;
    }
    .ena-qd__pack {
      padding: 13px 5px 11px;
    }
    .ena-qd__figure {
      height: 66px;
    }
    .ena-qd__qty {
      font-size: 12px;
    }
    .ena-qd__now {
      font-size: 14.5px;
    }
    .ena-qd__was {
      font-size: 11px;
    }
    .ena-qd__tag {
      font-size: 9px;
      padding: 3px 7px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Pack descuento",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "UI del pack builder. El descuento real se aplica con un Automatic Discount de Shopify (por cantidad) o una app de quantity breaks — este bloque solo muestra el total con descuento y setea la cantidad. Excluyente con Suscripción."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Comprá más y ahorrá"
    },
    {
      "type": "text",
      "id": "tag_prefix",
      "label": "Texto del tag de ahorro",
      "default": "AHORRÁ"
    },
    {
      "type": "range",
      "id": "pack2_discount",
      "label": "Descuento pack x2",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "pack3_discount",
      "label": "Descuento pack x3",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Imágenes de los packs"
    },
    {
      "type": "paragraph",
      "content": "Opcional. Si se deja vacío, el pack usa la imagen de la variante seleccionada (cambia con sabor/tamaño). Al cargar una imagen, ese pack la muestra fija (ideal para renders de 1/2/3 potes)."
    },
    {
      "type": "image_picker",
      "id": "image_x1",
      "label": "Imagen pack x1 (1 unidad)"
    },
    {
      "type": "image_picker",
      "id": "image_x2",
      "label": "Imagen pack x2 (2 unidades)"
    },
    {
      "type": "image_picker",
      "id": "image_x3",
      "label": "Imagen pack x3 (3 unidades)"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Pack descuento",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
