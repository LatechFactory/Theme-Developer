{%- comment -%}
  "Lo que vas a sentir" — benefits/results card. Percentages are ILLUSTRATIVE
  (per handoff): back with a real study or soften the claim before launch.
{%- endcomment -%}

<div
  class="ena-benefits spacing-style{% unless block.settings.animate %} reveal-off{% endunless %}"
  style="{% render 'spacing-style', settings: block.settings %}; --ena-accent: {{ block.settings.accent }}"
  data-reveal="fade-up"
  {{ block.shopify_attributes }}
>
  <p class="ena-benefits__heading ena-title">{{ block.settings.heading }}</p>
  {%- for i in (1..4) -%}
    {%- liquid
      assign t_key = 'title_' | append: i
      assign d_key = 'desc_' | append: i
      assign p_key = 'pct_' | append: i
      assign icon_key = 'icon_' | append: i
      assign b_title = block.settings[t_key]
    -%}
    {%- if b_title != blank -%}
      <div class="ena-benefits__row">
        <span class="ena-benefits__icon">
          {%- case block.settings[icon_key] -%}
            {%- when 'fuerza' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="22" height="22"><path d="M6.5 18.5c1.5-5 3-8.5 5-11 1.2-1.5 3.4-2 4.8-.8 1.3 1.1 1.4 3 .4 4.4-1.6 2.2-4.2 3.4-6.7 4.1M6.5 18.5c2.5.8 5.4.9 8 .2"/></svg>
            {%- when 'recuperacion' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="22" height="22"><rect x="8" y="4.5" width="8" height="16" rx="2.4"/><path d="M10.4 2.8h3.2M12 9v4"/></svg>
            {%- when 'energia' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="22" height="22"><path d="M13 2.5L5.5 13.5h5l-1 8L17.5 10h-5l.5-7.5z" stroke-linejoin="round"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="22" height="22"><rect x="4" y="4" width="16" height="16" rx="1.5"/><path d="M4 9.3h16M4 14.6h16M9.3 4v16M14.6 4v16"/></svg>
          {%- endcase -%}
        </span>
        <span class="ena-benefits__copy">
          <strong>{{ b_title }}</strong>
          <small>{{ block.settings[d_key] }}</small>
        </span>
        <span class="ena-benefits__pct">{{ block.settings[p_key] }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .ena-benefits {
    width: 100%;
    background: var(--ena-surface-soft);
    border-radius: 20px;
    padding: 40px 44px;
  }
  .ena-benefits__heading {
    text-align: center;
    font-size: 24px;
    margin: 0 0 26px;
  }
  .ena-benefits__row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--ena-border);
  }
  .ena-benefits__icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--ena-dark);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .ena-benefits__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ena-benefits__copy strong {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 16px;
    color: var(--ena-ink);
  }
  .ena-benefits__copy small {
    font-size: 13px;
    color: var(--ena-muted);
  }
  .ena-benefits__pct {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 27px;
    color: var(--ena-accent, #1e5fa8);
  }
  @media screen and (max-width: 749px) {
    .ena-benefits {
      padding: 26px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Beneficios",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Stats ILUSTRATIVOS — respaldar con estudio real antes de publicar."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que vas a sentir"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Color acento",
      "default": "#1E5FA8"
    },
    { "type": "header", "content": "Fila 1" },
    { "type": "select", "id": "icon_1", "label": "Icono", "default": "fuerza", "options": [ { "value": "fuerza", "label": "Fuerza" }, { "value": "recuperacion", "label": "Recuperación" }, { "value": "energia", "label": "Energía" }, { "value": "volumen", "label": "Volumen" } ] },
    { "type": "text", "id": "title_1", "label": "Título", "default": "Más fuerza" },
    { "type": "text", "id": "desc_1", "label": "Descripción", "default": "92% ganó fuerza y potencia" },
    { "type": "text", "id": "pct_1", "label": "Valor", "default": "92%" },
    { "type": "header", "content": "Fila 2" },
    { "type": "select", "id": "icon_2", "label": "Icono", "default": "recuperacion", "options": [ { "value": "fuerza", "label": "Fuerza" }, { "value": "recuperacion", "label": "Recuperación" }, { "value": "energia", "label": "Energía" }, { "value": "volumen", "label": "Volumen" } ] },
    { "type": "text", "id": "title_2", "label": "Título", "default": "Mejor recuperación" },
    { "type": "text", "id": "desc_2", "label": "Descripción", "default": "88% recuperó más rápido" },
    { "type": "text", "id": "pct_2", "label": "Valor", "default": "88%" },
    { "type": "header", "content": "Fila 3" },
    { "type": "select", "id": "icon_3", "label": "Icono", "default": "energia", "options": [ { "value": "fuerza", "label": "Fuerza" }, { "value": "recuperacion", "label": "Recuperación" }, { "value": "energia", "label": "Energía" }, { "value": "volumen", "label": "Volumen" } ] },
    { "type": "text", "id": "title_3", "label": "Título", "default": "Más energía" },
    { "type": "text", "id": "desc_3", "label": "Descripción", "default": "90% rindió más en cada entreno" },
    { "type": "text", "id": "pct_3", "label": "Valor", "default": "90%" },
    { "type": "header", "content": "Fila 4" },
    { "type": "select", "id": "icon_4", "label": "Icono", "default": "volumen", "options": [ { "value": "fuerza", "label": "Fuerza" }, { "value": "recuperacion", "label": "Recuperación" }, { "value": "energia", "label": "Energía" }, { "value": "volumen", "label": "Volumen" } ] },
    { "type": "text", "id": "title_4", "label": "Título", "default": "Más volumen muscular" },
    { "type": "text", "id": "desc_4", "label": "Descripción", "default": "85% notó más masa magra" },
    { "type": "text", "id": "pct_4", "label": "Valor", "default": "85%" },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable scroll animation",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Beneficios",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
