<div class="ena-trust spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <div class="ena-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><path d="M12 2.7l8.5 4.4v9.8L12 21.3l-8.5-4.4V7.1L12 2.7z"/><path d="M3.7 7.2L12 11.6l8.3-4.4M12 11.6v9.5"/></svg>
    <span>{{ block.settings.label_1 }}</span>
  </div>
  <div class="ena-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><path d="M9.5 7H16a5 5 0 0 1 0 10h-4"/><path d="M12.5 3.5L9 7l3.5 3.5"/></svg>
    <span>{{ block.settings.label_2 }}</span>
  </div>
  <div class="ena-trust__item">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><rect x="2.8" y="5" width="18.4" height="14" rx="2.5"/><path d="M2.8 9.6h18.4M6.5 15h4"/></svg>
    <span>{{ block.settings.label_3 }}</span>
  </div>
</div>

{% stylesheet %}
  .ena-trust {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: 8px;
  }
  .ena-trust__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex: 1;
    font-family: var(--font-body--family);
    font-size: 13.5px;
    color: var(--ena-text-secondary);
    text-align: center;
  }
  .ena-trust__item svg {
    color: var(--ena-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Iconos de confianza",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label_1",
      "label": "Etiqueta 1",
      "default": "Envío gratis"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Etiqueta 2",
      "default": "Devolución fácil"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Etiqueta 3",
      "default": "Pago seguro"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Iconos de confianza",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
