{%- comment -%}
  "Sumá a tu rutina" — quick-add upsell rows. An upsell/bundle app can replace this;
  the theme block quick-adds the product's first available variant via /cart/add.js.
{%- endcomment -%}

<div class="ena-upsell spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
  <p class="ena-caption ena-upsell__heading">{{ block.settings.heading }}</p>
  {%- for i in (1..2) -%}
    {%- liquid
      assign key = 'product_' | append: i
      assign p = block.settings[key]
    -%}
    {%- if p != blank -%}
      {%- assign pv = p.selected_or_first_available_variant -%}
      <div class="ena-upsell__row">
        <a class="ena-upsell__media" href="{{ p.url }}">
          {{ p.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: p.title, class: 'ena-upsell__img' }}
        </a>
        <div class="ena-upsell__info">
          <a class="ena-upsell__title" href="{{ p.url }}">{{ p.title }}</a>
          <span class="ena-upsell__prices">
            <strong>{{ pv.price | money | split: ',' | first }}</strong>
            {%- if pv.compare_at_price > pv.price -%}
              <s class="ena-compare">{{ pv.compare_at_price | money | split: ',' | first }}</s>
            {%- endif -%}
          </span>
        </div>
        <button
          type="button"
          class="ena-upsell__add"
          data-ena-quick-add="{{ pv.id }}"
          aria-label="Agregar {{ p.title | escape }} al carrito"
          {% unless pv.available %}disabled{% endunless %}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="19" height="19"><path d="M5 7.5h14l-1 12h-12l-1-12z"/><path d="M8.6 7.5a3.4 3.4 0 0 1 6.8 0"/></svg>
        </button>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .ena-upsell__heading {
    color: var(--ena-ink);
    margin: 0 0 12px;
  }
  .ena-upsell__row {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--ena-surface-soft);
    border-radius: 14px;
    padding: 12px;
    margin-bottom: 10px;
  }
  .ena-upsell__media {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--ena-surface);
  }
  .ena-upsell__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ena-upsell__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ena-upsell__title {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 15px;
    color: var(--ena-ink);
    text-decoration: none;
  }
  .ena-upsell__prices {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 14px;
  }
  .ena-upsell__prices strong {
    font-weight: 700;
    color: var(--ena-ink);
  }
  .ena-upsell__add {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ena-ink);
    color: #fff;
    border: none;
    display: grid;
    place-items: center;
    cursor: pointer;
    margin-right: 6px;
  }
  .ena-upsell__add[disabled] {
    opacity: 0.4;
    cursor: default;
  }
  .ena-upsell__add.is-added svg {
    display: none;
  }
  .ena-upsell__add.is-added::after {
    content: "✓";
    font-size: 17px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Upsell rutina",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Sumá a tu rutina"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Producto 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Producto 2"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Upsell rutina",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
