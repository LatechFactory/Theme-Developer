{%- liquid
  assign v = closest.product.selected_or_first_available_variant
  assign saving = 0
  if v.compare_at_price > v.price
    assign diff = v.compare_at_price | minus: v.price
    assign saving = diff | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}

{%- if saving > 0 -%}
  <div class="ena-badge spacing-style" style="{% render 'spacing-style', settings: block.settings %}" {{ block.shopify_attributes }}>
    {{ block.settings.prefix }} {{ saving }}%
  </div>
{%- endif -%}

{% stylesheet %}
  .ena-badge {
    display: inline-block;
    width: fit-content;
    background: var(--ena-ink);
    color: #fff;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ENA · Badge ahorro",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "prefix",
      "label": "Texto",
      "default": "AHORRÁ"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "ENA · Badge ahorro",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
